# ==============================================================================
# Environment Configuration for Montazh Backend
# ==============================================================================

# Environment mode: development | production | test
ENVIRONMENT=development

# Database
DATABASE_URL=sqlite+aiosqlite:///./database.sqlite

# Security (Change SECRET_KEY in production!)
SECRET_KEY=montazh-imperiya-super-secret-jwt-key-2026-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000","https://montazh.documentics.ru"]

# Default Admin Credentials for seeding
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Montazh2026!Admin
